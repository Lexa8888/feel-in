{
  "expo": {
    "name": "Feel In",
    "slug": "feel-in",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "feelin",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feelin.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Нужен доступ к камере для отправки фото",
        "NSMicrophoneUsageDescription": "Нужен доступ к микрофону для голосовых",
        "NSPhotoLibraryUsageDescription": "Нужен доступ к галерее для выбора фото",
        "NSCalendarsUsageDescription": "Feel In нужен доступ к календарю, чтобы импортировать важные даты и напоминания.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "com.feelin.app",
      "versionCode": 8,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F1A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "splash": {
      "backgroundColor": "#0F0F1A",
      "resizeMode": "contain"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableProguardInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0636e412-9635-4a63-a35d-bf97572f3861"
      },
      "abTests": {
        "chatBubbleShape": "rounded",
        "pulseAnimationSpeed": "normal",
        "widgetCompactMode": true
      }
    },
    "owner": "memfizz"
  }
}